    "@ghostchain/config": "1.0.0",
    "@ghostchain/contract-schemas": "*",
    "@ghostchain/types": "*",
    "@ghostchain/ui": "*",
    "next": "16.1.7",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2"
