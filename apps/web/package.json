{
  "name": "@ghostl/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "PORT=${PORT:-3200} NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev",
    "dev:inspect": "NODE_OPTIONS=--inspect=0.0.0.0:9230 PORT=${PORT:-3200} NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev",
