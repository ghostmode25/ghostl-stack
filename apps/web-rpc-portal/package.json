{
  "name": "@ghostchain/web-rpc-portal",
  "version": "0.1.0",
  "private": true,
  "description": "GhostChain RPC developer portal — rpc.ghostchain.cloud",
  "scripts": {
    "dev": "PORT=${PORT:-3015} next dev",
    "build": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 NEXT_DISABLE_ESLINT=1 next build",
    "start": "next start -p ${PORT:-3015}",
    "lint": "next lint"
  },
  "dependencies": {
    "@ghostchain/config": "1.0.0",
    "@ghostchain/ui-components": "*",
    "@ghostchain/ghost-sdk-core": "*",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.21.0 <23" }
}
