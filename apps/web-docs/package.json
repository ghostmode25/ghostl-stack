    "lint": "next lint"
  },
  "dependencies": {
    "@ghostchain/ui-components": "*",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "next-mdx-remote": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.21.0 <23" }
}
