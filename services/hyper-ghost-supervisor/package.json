    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.21.0 <23"
  }
}
